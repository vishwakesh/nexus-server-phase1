[Unit]
Description=NEXUS Server Phase 2 Auth Dashboard
After=network.target

[Service]
Type=simple
User=nexus-web
Group=nexus-web
WorkingDirectory=/opt/nexus-server-phase2
Environment=HOME=/var/lib/nexus-server-phase2
Environment=NEXUS_BIND=127.0.0.1
Environment=NEXUS_PORT=3001
Environment=NEXUS_DATA_DIR=/var/lib/nexus-server-phase2/data
Environment=NEXUS_TELANGANA_ONLY=true
Environment=NEXUS_COOKIE_SECURE=false
Environment=RUST_LOG=info
ExecStart=/opt/nexus-server-phase2/target/release/nexus-api
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexus-server-phase2/data

[Install]
WantedBy=multi-user.target
