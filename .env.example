# Phase 2 always rejects non-loopback bind addresses.
NEXUS_BIND=127.0.0.1
NEXUS_PORT=3001
NEXUS_DATA_DIR=/var/lib/nexus-server-phase2/data
RUST_LOG=info

# Remote requests are allowed only when an HTTPS proxy passes X-Forwarded-For
# and the detected public IP geolocates to Telangana, India.
NEXUS_TELANGANA_ONLY=true

# Set true BEFORE using HTTPS/ngrok/reverse proxy. Keep false only for private
# local HTTP testing, e.g. an SSH port forward to http://127.0.0.1:3001.
NEXUS_COOKIE_SECURE=false
